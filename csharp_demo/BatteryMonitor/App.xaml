<Application x:Class="BatteryMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#D5D7D9"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F3F4F4"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#7B7F82"/>
        <SolidColorBrush x:Key="CommandBrush" Color="#565B5E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#187B78"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CommandBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D3032"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="42"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Application.Resources>
</Application>
